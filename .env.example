# ── Azésa env template ──────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real values.

# ── Database (REQUIRED) ────────────────────────────────────────────────
# Managed Postgres connection string (Supabase / Neon / RDS / Render).
DATABASE_URL=postgres://user:***@host/db

# ── Auth (REQUIRED before production) ───────────────────────────────
# In production: must be set or the app refuses to boot / login returns 503.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@azesa.in
# Prefer a bcrypt hash of the admin password (never store plaintext):
ADMIN_PASSWORD_HASH=
#   Generate with:  npx tsx -e "console.log(require('bcryptjs').hashSync('PASSWORD',10))"
# Fallback (if no hash set): plaintext password, still compared in constant time.
# ADMIN_PASSWORD=change-me-strong-password

# Local-only: lets you open /admin without logging in. NEVER set in prod —
# it is automatically ignored when NODE_ENV=production.
# ADMIN_BYPASS=1

# ── Payments (optional; online checkout stays disabled until set) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── UPI Scan-&-Pay (no gateway) ────────────────────────────────────
# Set to YOUR OWN UPI ID (VPAA), e.g. name@okhdfcbank. Appears in the QR shown to customers.
NEXT_PUBLIC_UPI_ID=yourname@okbank
NEXT_PUBLIC_UPI_STORE=Azesa Chocolates
